# AI Git Task Processing Skills editor settings
# Author: Bohdan Kossak
# X: https://x.com/BohdanDJA
# License: MIT

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_size = 2
